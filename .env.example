# Turso (libSQL)
DATABASE_URL="libsql://distro-niro.aws-eu-north-1.turso.io"
TURSO_DATABASE_URL="libsql://distro-niro.aws-eu-north-1.turso.io"
TURSO_AUTH_TOKEN="paste-your-turso-token-here"

# Local SQLite fallback (uncomment for offline Prisma CLI work):
# DATABASE_URL="file:./dev.db"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# AES-256-GCM session encryption (preferred)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""
# Legacy alias (still accepted by lib/crypto.ts):
# SESSION_ENCRYPTION_KEY=""

# Chrome extension / API shared secret (sent as x-distro-key)
DISTRO_API_KEY="generate-a-long-random-string"

# App
NEXTAUTH_SECRET="change-me-in-production"
NEXT_PUBLIC_APP_URL="https://distro-auu6.vercel.app"

# Facebook Login (Meta App → Settings → Basic)
# Valid OAuth Redirect URIs (must match request origin used by /api/auth/facebook):
#   https://distro-auu6.vercel.app/api/auth/facebook/callback
#   http://localhost:3000/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Optional: set after Chrome Web Store assigns a stable extension ID
# so the dashboard can push AUTH_SUCCESS via chrome.runtime.sendMessage
# NEXT_PUBLIC_EXTENSION_ID=""

# Chrome Web Store listing URL (install CTA on login / dashboard)
# NEXT_PUBLIC_CHROME_WEB_STORE_URL="https://chromewebstore.google.com/detail/iegnppdljinjpehneimfjjchfnpgdbnk"

# Support contacts (WhatsApp preferred when set; otherwise mailto)
# NEXT_PUBLIC_SUPPORT_EMAIL="support@distro.app"
# NEXT_PUBLIC_SUPPORT_WHATSAPP="9725XXXXXXXX"

# Allow /api/auth/dev-login in production (default off). Reviewers should use
# reviewer@distro.app via /api/auth/login instead.
# ALLOW_DEV_LOGIN="false"

# Hybrid automation (extension heartbeat + cloud fallback cron)
# Protect /api/cron/check-schedules (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET="generate-a-long-random-string"
# Optional Playwright/Browserless worker for when the extension is offline >20m
# DISTRO_CLOUD_WORKER_URL="https://your-worker.example/run"
# DISTRO_CLOUD_WORKER_SECRET=""
