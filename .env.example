# Turso (libSQL)
DATABASE_URL="libsql://distro-niro.aws-eu-north-1.turso.io"
TURSO_AUTH_TOKEN="paste-your-turso-token-here"

# Local SQLite fallback (uncomment for offline Prisma CLI work):
# DATABASE_URL="file:./dev.db"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# AES-256-GCM session encryption (preferred)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""
# Legacy alias (still accepted by lib/crypto.ts):
# SESSION_ENCRYPTION_KEY=""

# Chrome extension / API shared secret (sent as x-distro-key)
DISTRO_API_KEY="generate-a-long-random-string"

# App
NEXTAUTH_SECRET="change-me-in-production"
