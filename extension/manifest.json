{
  "manifest_version": 3,
  "name": "Distro Facebook Sync",
  "version": "1.0.0",
  "description": "Sync joined Facebook groups to your Distro dashboard for content scheduling.",
  "permissions": ["cookies", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Distro - סנכרון קבוצות",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
